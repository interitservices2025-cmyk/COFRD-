# Copier ce fichier vers .env.local et renseigner les valeurs.

# --- Administration (obligatoire) ---
# Mot de passe de l'espace /admin
ADMIN_PASSWORD=
# Secret de signature des sessions (>= 16 caractères aléatoires, ex: openssl rand -hex 32)
SESSION_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiements Stripe (optionnel : sans clé, les billets payants restent « en attente ») ---
STRIPE_SECRET_KEY=
# Secret du webhook (Stripe CLI : stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# --- Courriels transactionnels Resend (optionnel : sans clé, envoi simulé dans la console) ---
RESEND_API_KEY=
EMAIL_FROM=COFRD <billetterie@cofrd.org>
